---
import '@fontsource/gloock/400.css';
import '@fontsource-variable/montserrat/wght.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** páginas que no queremos en Google (ej. la 404) */
  noIndex?: boolean;
}
const {
  title = 'Huellas en la Aldea · Cabañas en Las Bajadas, Calamuchita, Córdoba',
  description = 'Cabañas a orillas del arroyo Soconcho, en Las Bajadas (Calamuchita, Córdoba). Pileta de 27 m con jacuzzi, desayuno incluido, asador propio, pet friendly y abierto todo el año. Consultas por WhatsApp.',
  noIndex = false,
} = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagen = new URL('/compartir.jpg', Astro.site);
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#006a3b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Huellas en la Aldea" />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Atardecer sobre la pileta de Huellas en la Aldea" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonica} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/terrain/terrain.json" as="fetch" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LodgingBusiness',
      name: 'Huellas en la Aldea – Cabañas',
      description,
      telephone: '+5493512142137',
      email: 'huellasenlaaldea@gmail.com',
      petsAllowed: true,
      checkinTime: '14:00',
      checkoutTime: '10:00',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Ruta Provincial 36 km 729, Rucalhue Aldea Serrana',
        addressLocality: 'Las Bajadas',
        addressRegion: 'Córdoba',
        addressCountry: 'AR',
      },
      geo: { '@type': 'GeoCoordinates', latitude: -32.12166, longitude: -64.33176 },
      url: 'https://huellasenlaaldea.com.ar/',
      image: 'https://huellasenlaaldea.com.ar/compartir.jpg',
      logo: 'https://huellasenlaaldea.com.ar/icon-512.png',
      sameAs: ['https://www.instagram.com/huellasenlaaldea/'],
    })} />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <slot />
    <script>
      import '../scripts/revelar';
    </script>
  </body>
</html>
