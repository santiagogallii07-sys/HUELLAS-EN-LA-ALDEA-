---
import Foto from './Foto.astro';
import Icon, { type IconName } from './Icon.astro';
import cenital from '../assets/fotos/complejo-cenital.jpg';
import pileta from '../assets/fotos/pileta-dia.jpg';
import jacuzzi from '../assets/fotos/jacuzzi.jpg';
import remanso from '../assets/fotos/arroyo-remanso.jpg';
import paseo from '../assets/fotos/arroyo-paseo.jpg';
import aljibe from '../assets/fotos/aljibe.jpg';
import juegos from '../assets/fotos/juegos-metegol.jpg';
import laguna from '../assets/fotos/laguna.jpg';
import embarcadero1 from '../assets/fotos/embarcadero-1.jpg';
import embarcadero2 from '../assets/fotos/embarcadero-2.jpg';
import barco from '../assets/fotos/barco-1.jpg';
import volley from '../assets/fotos/volley-1.jpg';

type Foto = { src: ImageMetadata; alt: string };
type Ref = {
  id: string;
  icon: IconName;
  nombre: string;
  /** nombre corto para la lista y la etiqueta del mapa */
  corto?: string;
  texto: string;
  pos?: [number, number];
  fotos?: Foto[];
  /** aparece en la lista de referencias (las demás solo se marcan en el mapa) */
  lista?: boolean;
};
// pos: porcentaje sobre la foto cenital (marcado por el cliente). Las cabañas no se marcan a propósito.
const refs: Ref[] = [
  { id: 'pileta', icon: 'wavesLadder', corto: 'Pileta', nombre: 'Pileta de 27 m', texto: 'Con reposeras, sombrillas y luces para disfrutarla también de noche.', pos: [53.8, 52], lista: true, fotos: [{ src: pileta, alt: 'Pileta con reposeras y sombrillas, vista entre los árboles' }] },
  { id: 'jacuzzi', icon: 'droplets', nombre: 'Jacuzzi', texto: 'Junto a la pileta, para quedarse charlando.', lista: true, fotos: [{ src: jacuzzi, alt: 'Dos amigas sonriendo en el jacuzzi' }] },
  { id: 'laguna', icon: 'waves', nombre: 'Laguna', texto: 'Agua quieta y sombra de árboles, con mesas para sentarse a mirarla.', pos: [72.5, 36.8], lista: true, fotos: [{ src: laguna, alt: 'Mesa a la sombra de un árbol, junto a la laguna' }] },
  { id: 'dique', icon: 'dam', corto: 'Dique y paseo', nombre: 'Dique y paseo de piedra', texto: 'Un paseo de piedra sobre el agua, para la caminata de la tarde.', pos: [68.3, 29.5], lista: true, fotos: [{ src: paseo, alt: 'Dos personas caminando sobre el paseo de piedra del dique' }] },
  { id: 'barcos', icon: 'sailboat', nombre: 'Botes', texto: 'Para salir a remar por el arroyo, sin costo extra.', pos: [70, 54.6], lista: true, fotos: [{ src: barco, alt: 'Tres personas remando en un bote; otro bote amarrado en la orilla' }] },
  { id: 'embarcadero', icon: 'anchor', nombre: 'Embarcadero', texto: 'Escalones de piedra junto al agua, donde esperan los botes.', pos: [63.9, 59.9], lista: true, fotos: [
    { src: embarcadero1, alt: 'Embarcadero de piedra con botes y una canoa sobre el arroyo' },
    { src: embarcadero2, alt: 'Botes amarrados junto a la escalera de piedra del embarcadero' },
  ] },
  // Juegos: acá se suman las fotos nuevas (juegos para chicos, etc.)
  { id: 'juegos', icon: 'trees', nombre: 'Juegos', texto: 'Metegol y mesas a la sombra de los algarrobos, y juegos para chicos.', lista: true, fotos: [{ src: juegos, alt: 'Dos amigos jugando al metegol bajo los árboles' }] },
  { id: 'quincho', icon: 'beef', corto: 'Quincho', nombre: 'Quincho y SUM', texto: 'Asador grande, horno de barro y fogonero. Para eventos: el SUM recibe hasta 60 personas y el complejo aloja hasta 50 para pasar la noche.', lista: true },
  { id: 'almacen', icon: 'store', corto: 'Almacén', nombre: 'Almacén con proveeduría', texto: 'Para resolver lo que falte sin salir del complejo.', lista: true },
  { id: 'desayuno', icon: 'coffee', corto: 'Desayuno', nombre: 'Desayuno incluido', texto: 'Café, leche, medialunas y criollos, incluido con tu estadía.', lista: true },
  // Solo marcados en el mapa
  { id: 'arroyo', icon: 'fish', nombre: 'Arroyo Soconcho', texto: 'Rodea el predio. Se puede pescar, sin costo extra.', pos: [49.5, 82.1], fotos: [{ src: remanso, alt: 'Remanso del arroyo rodeado de monte' }] },
  { id: 'volley', icon: 'volleyball', corto: 'Vóley', nombre: 'Cancha de vóley', texto: 'Sobre el pasto, para el partido de la tarde.', pos: [62.3, 33.9], fotos: [{ src: volley, alt: 'Grupo jugando al vóley en la cancha de pasto, con las sierras de fondo' }] },
  { id: 'aljibe', icon: 'stone', corto: 'Aljibe', nombre: 'Aljibe y muros de piedra', texto: 'Piedra trabajada a mano en los espacios comunes.', pos: [54.8, 36.4], fotos: [{ src: aljibe, alt: 'Aljibe de piedra con faroles y escalera' }] },
];
const corto = (r: Ref) => r.corto ?? r.nombre;

---
<section class="predio" id="predio" aria-labelledby="t-predio" data-zoom="1">
  <div class="wrap predio__cabeza">
    <h2 id="t-predio" data-r="sube">Espacio de sobra para bajar un cambio</h2>
    <p class="lead" data-r="sube" style="--d:80ms">
      Las cabañas están repartidas por el predio, con espacio entre una y otra, y el arroyo Soconcho lo rodea casi entero. Tocá cada referencia para verla de cerca.
    </p>
  </div>

  <div class="predio__mapa">
    <figure class="predio__foto" data-r="foto">
      <Foto src={cenital} formats={['avif', 'webp']} widths={[800, 1400, 2000]} sizes="(min-width: 1000px) 66vw, 100vw" alt="Vista aérea del predio: el arroyo rodea las cabañas y la pileta" loading="lazy" />
      {refs.filter((r) => r.pos).map((r, i) => (
        <button
          type="button"
          class="marca"
          style={`left:${r.pos![0]}%;top:${r.pos![1]}%;--n:${i}`}
          data-ref={r.id}
          aria-label={r.nombre}
          aria-pressed="false"
        >
          <Icon name={r.icon} size={16} />
          <span class="marca__nombre" aria-hidden="true">{corto(r)}</span>
        </button>
      ))}
      <figcaption class="sr-only">Foto aérea del predio con referencias</figcaption>
    </figure>

    <div class="predio__panel">
      <div class="refs" data-r="sube" style="--d:120ms">
        <p class="rotulo refs__titulo" id="refs-titulo">Referencias</p>
        <ul class="refs__lista" aria-labelledby="refs-titulo">
          {refs.filter((r) => r.lista).map((r) => (
            <li>
              <button type="button" class="ref" data-ref={r.id} aria-pressed="false">
                <span class="ref__simbolo"><Icon name={r.icon} size={17} /></span>
                {corto(r)}
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="fichas" aria-live="polite">
        {refs.map((r) => (
          <article class="ficha" data-ficha={r.id} hidden>
            {r.fotos ? (
              <div class="ficha__fotos">
                <div class="ficha__tira">
                  {r.fotos.map((f) => (
                    <Foto src={f.src} formats={['avif', 'webp']} widths={[480, 800]} sizes="(min-width: 1000px) 400px, 100vw" alt={f.alt} loading="lazy" />
                  ))}
                </div>
                {r.fotos.length > 1 && (
                  <div class="ficha__puntos">
                    {r.fotos.map((_, i) => (
                      <button type="button" aria-label={`Foto ${i + 1} de ${r.fotos!.length}`} aria-current={i === 0 ? 'true' : 'false'}></button>
                    ))}
                  </div>
                )}
              </div>
            ) : (
              <div class="ficha__fotos ficha__fotos--icono" aria-hidden="true">
                <Icon name={r.icon} size={52} />
              </div>
            )}
            <div class="ficha__texto">
              <h3>{r.nombre}</h3>
              <p>{r.texto}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .predio {
    padding-block: clamp(5rem, 10vw, 9rem) clamp(4rem, 8vw, 7rem);
  }

  .predio__cabeza {
    display: grid;
    gap: 1.4rem 4rem;
    align-items: end;
  }

  @media (min-width: 1000px) {
    .predio__cabeza {
      grid-template-columns: 1.2fr 1fr;
    }
    .predio__cabeza h2 {
      max-width: 12ch;
    }
  }

  .predio__mapa {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 1000px) {
    .predio__mapa {
      grid-template-columns: minmax(0, 1fr) minmax(340px, 400px);
      gap: 3rem;
      padding-right: var(--gutter);
      align-items: start;
    }
  }

  /* Foto aérea con las marcas */
  .predio__foto {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--verde-hondo);
  }

  @media (min-width: 1000px) {
    .predio__foto {
      border-radius: 0 16px 16px 0;
    }
  }

  .predio__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .predio__foto:not(:global(.visto)) .marca {
      opacity: 0;
      transform: scale(0.4);
    }
    .marca {
      transition:
        opacity 0.3s var(--ease-out),
        transform 0.45s var(--ease-out);
      transition-delay: calc(0.35s + var(--n) * 70ms);
    }
  }

  .marca {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--verde);
    cursor: pointer;
  }

  .marca[aria-pressed='true'] {
    z-index: 2;
  }

  .marca::before {
    content: '';
    position: absolute;
    inset: 7px;
    border-radius: 50%;
    background: var(--blanco);
    box-shadow:
      0 0 0 2px var(--verde),
      0 6px 14px -4px rgb(0 0 0 / 0.5);
    transition:
      background-color 0.25s,
      transform 0.4s var(--ease-out);
  }

  .marca :global(.icon) {
    position: relative;
  }

  /* Etiqueta con el nombre: al pasar el mouse y en la marca elegida */
  .marca__nombre {
    position: absolute;
    bottom: calc(100% - 2px);
    left: 50%;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    background: var(--verde-noche);
    color: var(--blanco);
    font-size: 0.8125rem;
    font-weight: 650;
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition:
      opacity 0.2s,
      transform 0.3s var(--ease-out);
  }

  .marca[aria-pressed='true'] .marca__nombre {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (hover: hover) {
    .marca:hover::before {
      transform: scale(1.15);
    }
    .marca:hover .marca__nombre {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  .marca:focus-visible .marca__nombre {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .marca[aria-pressed='true'] {
    color: var(--verde-noche);
  }

  .marca[aria-pressed='true']::before {
    animation: pop 0.45s var(--ease-out);
    background: var(--naranja);
    transform: scale(1.2);
    box-shadow:
      0 0 0 3px var(--verde-noche),
      0 6px 14px -4px rgb(0 0 0 / 0.5);
  }

  @keyframes pop {
    0% {
      transform: scale(0.8);
    }
    60% {
      transform: scale(1.32);
    }
    100% {
      transform: scale(1.2);
    }
  }

  /* Panel: lista de referencias + ficha de la elegida */
  .predio__panel {
    display: grid;
    /* minmax(0, …): sin esto la tira deslizable del celular ensancha toda la página */
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    min-width: 0;
  }

  @media (min-width: 1000px) {
    .predio__panel {
      gap: 1.75rem;
    }
  }

  .refs__titulo {
    color: var(--tinta);
  }

  .refs__lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ref {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    min-height: 48px;
    padding: 0.4rem 0.9rem 0.4rem 0.45rem;
    border: 1.5px solid var(--linea);
    border-radius: 999px;
    background: var(--blanco);
    color: var(--tinta);
    font: 650 0.9375rem/1.2 var(--f-texto);
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.25s,
      border-color 0.25s,
      color 0.25s,
      transform 0.3s var(--ease-out);
  }

  .ref__simbolo {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--verde-claro);
    color: var(--verde);
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  @media (hover: hover) {
    .ref:hover {
      border-color: var(--verde);
    }
  }

  .ref:active {
    transform: scale(0.97);
  }

  .ref[aria-pressed='true'] {
    border-color: var(--verde-hondo);
    background: var(--verde-hondo);
    color: var(--blanco);
  }

  .ref[aria-pressed='true'] .ref__simbolo {
    background: var(--naranja);
    color: var(--verde-noche);
  }

  /* Ficha */
  .ficha {
    overflow: hidden;
    border-radius: 16px;
    background: var(--blanco);
    box-shadow: 0 24px 48px -30px rgb(7 42 25 / 0.55);
    animation: ficha 0.4s var(--ease-out);
  }

  @keyframes ficha {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .ficha__fotos {
    position: relative;
    aspect-ratio: 3 / 2;
    background: var(--verde-papel);
  }

  .ficha__tira {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .ficha__tira::-webkit-scrollbar {
    display: none;
  }

  .ficha__tira :global(img) {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scroll-snap-align: start;
  }

  .ficha__fotos--icono {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 50%, rgb(247 166 0 / 0.16), transparent 55%),
      var(--verde-hondo);
    color: var(--naranja);
  }

  .ficha__puntos {
    position: absolute;
    left: 50%;
    bottom: 0.5rem;
    display: flex;
    padding: 0 0.2rem;
    border-radius: 999px;
    background: rgb(7 42 25 / 0.45);
    transform: translateX(-50%);
  }

  .ficha__puntos button {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .ficha__puntos button::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.55);
    transition:
      background-color 0.2s,
      transform 0.3s var(--ease-out);
  }

  .ficha__puntos button[aria-current='true']::before {
    background: var(--blanco);
    transform: scale(1.3);
  }

  .ficha__texto {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem 1.3rem;
  }

  .ficha__texto h3 {
    font-size: clamp(1.45rem, 2vw, 1.7rem);
    color: var(--verde-hondo);
  }

  .ficha__texto p {
    font-size: 0.975rem;
    line-height: 1.55;
    color: var(--tinta-suave);
  }

  /* Computadora: botones en dos columnas */
  @media (min-width: 1000px) {
    .refs__titulo {
      padding-bottom: 0.8rem;
      margin-bottom: 1rem;
      border-bottom: 2px solid var(--tinta);
    }
    .refs__lista {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }
  }

  /* Celular y tablet: mapa, tira deslizable de botones y la ficha abajo */
  @media (max-width: 999px) {
    .refs__titulo {
      padding-inline: var(--gutter);
      margin-bottom: 0.6rem;
    }
    .refs__lista {
      display: flex;
      gap: 0.5rem;
      padding: 2px var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scroll-padding-inline: var(--gutter);
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 var(--gutter), #000 calc(100% - 2.5rem), transparent);
      mask-image: linear-gradient(90deg, transparent, #000 var(--gutter), #000 calc(100% - 2.5rem), transparent);
    }
    .refs__lista::-webkit-scrollbar {
      display: none;
    }
    .refs__lista li {
      flex: none;
      scroll-snap-align: start;
    }
    .fichas {
      padding-inline: var(--gutter);
    }
    .ficha__texto {
      padding: 1rem 1.1rem 1.15rem;
    }
    /* Marcas más chicas para que no se pisen */
    .marca::before {
      inset: 10px;
    }
    .marca :global(.icon) {
      width: 13px;
      height: 13px;
    }
    .marca__nombre {
      bottom: calc(100% - 6px);
      font-size: 0.75rem;
    }
  }

  /* Tablet: entran todas las referencias en dos renglones, sin deslizar */
  @media (min-width: 640px) and (max-width: 999px) {
    .refs__lista {
      flex-wrap: wrap;
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .fichas {
      max-width: 34rem;
    }
  }
</style>

<script>
  const raiz = document.querySelector<HTMLElement>('.predio')!;
  const botones = [...raiz.querySelectorAll<HTMLButtonElement>('[data-ref]')];
  const fichas = [...raiz.querySelectorAll<HTMLElement>('[data-ficha]')];
  const lista = raiz.querySelector<HTMLElement>('.refs__lista')!;

  const elegir = (id: string, desdeMapa = false) => {
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ref === id)));
    fichas.forEach((f) => (f.hidden = f.dataset.ficha !== id));
    // Si se tocó en el mapa, acomodar la tira del celular para que se vea el botón elegido
    const enLista = lista.querySelector<HTMLElement>(`[data-ref="${id}"]`);
    if (desdeMapa && enLista && lista.scrollWidth > lista.clientWidth) {
      const li = enLista.parentElement!;
      lista.scrollTo({ left: li.offsetLeft - (lista.clientWidth - li.offsetWidth) / 2, behavior: 'smooth' });
    }
  };

  botones.forEach((b) => b.addEventListener('click', () => elegir(b.dataset.ref!, b.classList.contains('marca'))));

  // Fichas con varias fotos: puntos que siguen al deslizar
  raiz.querySelectorAll<HTMLElement>('.ficha__fotos').forEach((caja) => {
    const tira = caja.querySelector<HTMLElement>('.ficha__tira');
    const puntos = [...caja.querySelectorAll<HTMLButtonElement>('.ficha__puntos button')];
    if (!tira || !puntos.length) return;
    puntos.forEach((p, i) => p.addEventListener('click', () => tira.scrollTo({ left: i * tira.clientWidth, behavior: 'smooth' })));
    tira.addEventListener(
      'scroll',
      () => {
        const i = Math.round(tira.scrollLeft / tira.clientWidth);
        puntos.forEach((p, j) => p.setAttribute('aria-current', String(i === j)));
      },
      { passive: true },
    );
  });

  elegir('pileta');
</script>
