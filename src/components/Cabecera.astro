---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import WhatsApp from './WhatsApp.astro';
import { waLink } from '../datos';

const links = [
  { href: '#predio', text: 'El predio' },
  { href: '#cabana', text: 'La cabaña' },
  { href: '#arroyo', text: 'El arroyo' },
  { href: '#como-llegar', text: 'Cómo llegar' },
];
const niveles = [
  { href: '#cabana', text: 'Cabaña', escala: '5 m' },
  { href: '#predio', text: 'Predio', escala: '100 m' },
  { href: '#valle', text: 'Valle', escala: '5 km' },
];
---
<header class="cab" data-modo="foto">
  <a class="cab__logo" href="#valle" aria-label="Huellas en la Aldea, ir al inicio">
    <Logo />
  </a>
  <nav class="cab__nav" aria-label="Secciones">
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}
    </ul>
  </nav>
  <a class="btn cab__wa" href={waLink()} target="_blank" rel="noopener" data-wa="cabecera">
    <WhatsApp /> <span>Consultá</span>
  </a>
  <button class="cab__menu" type="button" aria-expanded="false" aria-controls="menu-movil">
    <Icon name="menu" class="i-abrir" />
    <Icon name="x" class="i-cerrar" />
    <span class="sr-only">Menú</span>
  </button>
  <div class="cab__hoja" id="menu-movil" hidden>
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}
      <li><a href="#consulta">Consultá</a></li>
    </ul>
  </div>
</header>

<nav class="zoom" aria-label="Nivel de acercamiento">
  <span class="zoom__signo" aria-hidden="true"><Icon name="plus" size={16} /></span>
  <ol class="zoom__riel">
    {niveles.map((n, i) => (
      <li style={`--i:${2 - i}`}>
        <a href={n.href}><span class="zoom__nombre">{n.text}</span><span class="zoom__escala">{n.escala}</span></a>
      </li>
    ))}
    <span class="zoom__cursor" aria-hidden="true"></span>
  </ol>
  <span class="zoom__signo" aria-hidden="true"><Icon name="minus" size={16} /></span>
</nav>

<style>
  .cab {
    --logo-a: #fff;
    --logo-b: var(--naranja);
    --logo-c: rgb(255 255 255 / 0.85);
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 4.5rem;
    padding: 0 var(--gutter);
    padding-top: env(safe-area-inset-top);
    color: var(--blanco);
    transition:
      background-color 0.4s,
      color 0.4s,
      box-shadow 0.4s,
      transform 0.35s var(--ease-out);
  }

  .cab[data-oculta] {
    transform: translateY(-110%);
  }

  .cab[data-modo='foto'] {
    background: transparent;
  }

  .cab[data-modo='claro'] {
    --logo-a: var(--verde);
    --logo-b: var(--naranja);
    --logo-c: var(--gris);
    background: rgb(241 244 238 / 0.94);
    color: var(--tinta);
    box-shadow: 0 1px 0 var(--linea);
  }

  @supports (backdrop-filter: blur(1px)) {
    .cab[data-modo='claro'] {
      background: rgb(241 244 238 / 0.82);
      backdrop-filter: blur(14px) saturate(1.4);
    }
  }

  .cab__logo {
    display: block;
    width: 112px;
    flex: none;
  }

  .cab__logo :global(.logo) {
    width: 100%;
    height: auto;
  }

  .cab__nav {
    margin-left: auto;
  }

  .cab__nav ul {
    display: flex;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cab__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.8rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .cab__nav a {
    position: relative;
  }

  .cab__nav a::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.55rem;
    height: 2px;
    border-radius: 2px;
    background: var(--naranja);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }

  @media (hover: hover) {
    .cab__nav a:hover::after {
      transform: scaleX(1);
    }
  }

  .cab__wa {
    min-height: 44px;
    padding: 0.6em 1.15em;
    font-size: 0.9375rem;
  }

  .cab__menu {
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-right: -0.5rem;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .cab__menu :global(.i-cerrar),
  .cab__menu[aria-expanded='true'] :global(.i-abrir) {
    display: none;
  }

  .cab__menu[aria-expanded='true'] :global(.i-cerrar) {
    display: block;
  }

  .cab__hoja {
    position: absolute;
    top: 100%;
    left: 0.75rem;
    right: 0.75rem;
    padding: 0.5rem;
    background: var(--verde-noche);
    color: var(--blanco);
    border-radius: 14px;
    box-shadow: 0 24px 50px -20px rgb(0 0 0 / 0.6);
    transform-origin: top right;
    animation: hoja 0.35s var(--ease-out);
  }

  @keyframes hoja {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(-6px);
    }
  }

  .cab__hoja ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cab__hoja a {
    display: block;
    padding: 0.95rem 1rem;
    font-family: var(--f-titulo);
    font-size: 1.6rem;
    text-decoration: none;
    border-radius: 8px;
  }

  .cab__hoja li + li {
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  @media (max-width: 899px) {
    .cab {
      height: 4rem;
      gap: 0.75rem;
    }
    .cab__logo {
      width: 92px;
      margin-right: auto;
    }
    .cab__nav {
      display: none;
    }
    .cab__menu {
      display: grid;
    }
    .cab__wa {
      padding: 0.55em 0.95em;
    }
  }

  /* Indicador de zoom: funciona como navegación */
  .zoom {
    position: fixed;
    right: 0.5rem;
    top: 50%;
    z-index: 40;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.35rem;
    border-radius: 999px;
    background: rgb(7 42 25 / 0.82);
    color: var(--blanco);
    transform: translateY(-50%);
    box-shadow: 0 10px 30px -14px rgb(0 0 0 / 0.5);
  }

  @supports (backdrop-filter: blur(1px)) {
    .zoom {
      background: rgb(7 42 25 / 0.62);
      backdrop-filter: blur(10px);
    }
  }

  @media (min-width: 1100px) and (min-height: 560px) {
    .zoom {
      display: flex;
    }
  }

  .zoom__signo {
    display: grid;
    place-items: center;
    width: 28px;
    height: 20px;
    opacity: 0.7;
  }

  .zoom__riel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    margin: 0;
    padding: 0.4rem 0;
    list-style: none;
  }

  .zoom__riel::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 2px;
    margin-left: -1px;
    background: rgb(255 255 255 / 0.3);
  }

  .zoom__riel a {
    position: relative;
    display: block;
    width: 28px;
    height: 28px;
    border-radius: 50%;
  }

  .zoom__riel a::before {
    content: '';
    position: absolute;
    inset: 9px;
    border-radius: 50%;
    background: var(--blanco);
  }

  .zoom__nombre,
  .zoom__escala {
    position: absolute;
    right: calc(100% + 0.9rem);
    white-space: nowrap;
    pointer-events: none;
  }

  .zoom__nombre {
    top: -0.1rem;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--verde-noche);
    font-size: 0.8125rem;
    font-weight: 650;
    opacity: 0;
    transform: translateX(6px);
    transition:
      opacity 0.25s,
      transform 0.35s var(--ease-out);
  }

  .zoom__escala {
    display: none;
  }

  .zoom__riel a:hover .zoom__nombre,
  .zoom__riel a:focus-visible .zoom__nombre {
    opacity: 1;
    transform: none;
  }

  .zoom__cursor {
    --nivel: 0;
    position: absolute;
    left: 50%;
    bottom: 0.4rem;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    margin-bottom: 5px;
    border-radius: 50%;
    background: var(--naranja);
    box-shadow: 0 0 0 3px rgb(7 42 25 / 0.9);
    transform: translateY(calc(var(--nivel) * -1 * (28px + 1.6rem)));
    transition: transform 0.6s var(--ease-out);
    pointer-events: none;
  }

  .zoom__cursor.directo {
    transition: none;
  }
</style>

<script>
  const cab = document.querySelector<HTMLElement>('.cab')!;
  const boton = cab.querySelector<HTMLButtonElement>('.cab__menu')!;
  const hoja = cab.querySelector<HTMLElement>('.cab__hoja')!;

  const cerrar = () => {
    boton.setAttribute('aria-expanded', 'false');
    hoja.hidden = true;
  };
  boton.addEventListener('click', () => {
    const abrir = boton.getAttribute('aria-expanded') !== 'true';
    boton.setAttribute('aria-expanded', String(abrir));
    hoja.hidden = !abrir;
  });
  hoja.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) cerrar();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrar();
  });

  // Cabecera transparente sobre el video, clara después; se esconde al bajar y vuelve al subir.
  // Si arriba hay un video (data-fondo-oscuro), la cabecera va transparente y en blanco
  const fondoOscuro = document.querySelector<HTMLElement>('[data-fondo-oscuro]');
  const cursor = document.querySelector<HTMLElement>('.zoom__cursor')!;
  const items = [...document.querySelectorAll<HTMLLIElement>('.zoom__riel li')];
  const secciones = [...document.querySelectorAll<HTMLElement>('main section[data-zoom]')];
  let ultimoY = window.scrollY;

  const actualizar = () => {
    const y = window.scrollY;
    const r = fondoOscuro?.getBoundingClientRect();
    cab.dataset.modo = r && r.top < 10 && r.bottom > 72 ? 'foto' : 'claro';
    const bajando = y > ultimoY + 4;
    const subiendo = y < ultimoY - 4;
    if (boton.getAttribute('aria-expanded') !== 'true') {
      if (bajando && y > window.innerHeight * 0.6) cab.dataset.oculta = '';
      else if (subiendo || y < 80) delete cab.dataset.oculta;
    }
    if (bajando || subiendo) ultimoY = y;

    let nivel = 0;
    const linea = window.innerHeight * 0.45;
    for (const s of secciones) if (s.getBoundingClientRect().top < linea) nivel = Number(s.dataset.zoom);
    cursor.style.setProperty('--nivel', String(nivel));
    items.forEach((li) => li.classList.toggle('actual', Number(li.style.getPropertyValue('--i')) === nivel));
  };

  let pedido = false;
  window.addEventListener(
    'scroll',
    () => {
      if (pedido) return;
      pedido = true;
      requestAnimationFrame(() => {
        pedido = false;
        actualizar();
      });
    },
    { passive: true },
  );
  // Al elegir una sección desde el menú, mostrar la cabecera igual
  document.addEventListener('focusin', (e) => {
    if (cab.contains(e.target as Node)) delete cab.dataset.oculta;
  });
  actualizar();
</script>
