---
import Base from '../layouts/Base.astro';
import PaginaSimple from '../components/PaginaSimple.astro';
---
<Base title="Página no encontrada · Huellas en la Aldea" noIndex>
  <PaginaSimple>
    <h1>Acá no hay huellas</h1>
    <p>La página que buscás no existe o cambió de lugar. Volvé al inicio y seguí recorriendo el complejo.</p>
    <a class="btn btn--verde" href="/">Volver al inicio</a>
  </PaginaSimple>
</Base>
